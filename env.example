# API Keys - Get your API keys from the provider websites
# Google Gemini: https://makersuite.google.com/app/apikey
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# DeepSeek: https://platform.deepseek.com/
# Kimi AI Global: https://platform.moonshot.ai/
# Kimi AI China: https://platform.moonshot.cn/

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
KIMICN_API_KEY=

LOCAL_API_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:0.5b


# Default AI Provider
# Options: gemini, openai, anthropic, deepseek, kimi, kimicn
DEFAULT_PROVIDER=local

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO
MAX_TEXT_LENGTH=1000000

# API Security
# API_MODE: 'public' (no authentication) or 'private' (requires API key)
API_MODE=public
# SERVER_API_KEY: Your secret API key (generate a strong random key for production)
# Example: SERVER_API_KEY=nlp-qg-1a2b3c4d5e6f7g8h9i0j
SERVER_API_KEY=

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_DAYS=30
CACHE_MAX_ENTRIES=1000

# Streaming Configuration
STREAMING_ENABLED=true

# Parallel Processing Configuration
PARALLEL_ENABLED=true
PARALLEL_CHUNK_SIZE=10
PARALLEL_MAX_WORKERS=5
PARALLEL_THRESHOLD=20

# Quality Scoring Configuration
# Note: Scoring uses additional API calls. Disable if not needed.
QUALITY_SCORING_ENABLED=false
QUALITY_MIN_SCORE=6
QUALITY_MAX_RETRIES=2
QUALITY_SCORER_PROVIDER=gemini
QUALITY_QUICK_SCORE=true

# Deduplication Configuration
DEDUP_ENABLED=true
DEDUP_THRESHOLD=85
DEDUP_COMPARE_OPTIONS=true
DEDUP_KEEP_BEST=true

# Difficulty Balancing Configuration
DIFFICULTY_BALANCE_ENABLED=true
DIFFICULTY_BALANCE_TOLERANCE=0.10
DIFFICULTY_BALANCE_MAX_RETRIES=2

# Error Handling & Retry Configuration
ERROR_MAX_RETRIES=3
ERROR_BASE_DELAY=1000
ERROR_MAX_DELAY=30000
ERROR_CIRCUIT_BREAKER_THRESHOLD=5

# Smart Routing Configuration
SMART_ROUTING_ENABLED=true
ROUTING_PRIORITY=balanced

# Job Queue Configuration
QUEUE_ENABLED=false
QUEUE_WORKERS=3

# ==================================
# LOCAL PROVIDER CONFIGURATION
# ==================================
# For Ollama/LocalAI with vision models (e.g., Qwen3-VL, LLaVA)
# These settings are tuned for limited VRAM (4GB GPUs like RTX 3050)

# Local LLM endpoint
LOCAL_API_URL=http://localhost:11434

# Model to use (vision models: qwen2.5-vl:3b, llava, llava:13b)
LOCAL_MODEL=qwen2.5-vl:3b

# Context size - reduce if running out of memory (default: 4096)
LOCAL_CTX_SIZE=4096

# Chunking configuration for large documents
# Max text characters per chunk (smaller = less memory, more chunks)
LOCAL_MAX_TEXT_CHARS=8000

# Max images per chunk (smaller = less memory, but may lose context)
LOCAL_MAX_IMAGES=3

# Questions to generate per chunk (smaller = faster per chunk)
LOCAL_QUESTIONS_PER_CHUNK=3

# Timeout per chunk in ms (3 minutes default)
LOCAL_CHUNK_TIMEOUT=180000

# Delay between chunks in ms (helps GPU cool down)
LOCAL_CHUNK_DELAY=1000

# Retry configuration for JSON parsing failures (small models often need retries)
LOCAL_MAX_RETRIES=2
LOCAL_RETRY_DELAY=2000

